# Добавьте эти значения в Vercel → Project Settings → Environment Variables.
# Сам файл .env не добавляйте в Git.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/ushqan_uya?retryWrites=true&w=majority
APP_JWT_SECRET=replace-with-a-random-32-character-or-longer-secret
ADMIN_EMAIL=admin@ushqan-uya.local
ADMIN_PASSWORD=replace-with-the-private-admin-password

# Необязательно. Максимальный размер прикрепленного файла в байтах.
MAX_UPLOAD_BYTES=4194304
